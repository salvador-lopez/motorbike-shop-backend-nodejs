{
  "name": "app",
  "version": "1.0.0",
  "description": "This project holds all the backend business logic and all the UIs (i.e. API REST) needed to create a motorbike shop",
  "main": "dist/app.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testMatch='**/*.unit.test.ts'",
    "test:unit:debug": "node --inspect-brk=0.0.0.0:9229 ./node_modules/.bin/jest --runInBand --testMatch='**/*.unit.test.ts'",
    "test:integration": "jest --testMatch='**/*.integration.test.ts'",
    "test:integration:debug": "node --inspect-brk=0.0.0.0:9229 ./node_modules/.bin/jest --runInBand --testMatch='**/*.integration.test.ts'",
    "test:acceptance": " jest --testMatch='**/*.acceptance.test.ts'",
    "test:acceptance:debug": "node --inspect-brk=0.0.0.0:9229 ./node_modules/.bin/jest --runInBand --testMatch='**/*.acceptance.test.ts'",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvador-lopez/motorbike-shop-backend-nodejs.git"
  },
  "author": "slopez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/salvador-lopez/motorbike-shop-backend-nodejs/issues"
  },
  "homepage": "https://github.com/salvador-lopez/motorbike-shop-backend-nodejs#readme",
  "dependencies": {
    "@node-ts/bus-core": "^1.3.1",
    "@node-ts/bus-messages": "^1.1.0",
    "awilix": "^12.0.5",
    "awilix-express": "^9.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.21",
    "uuid": "^11.1.0",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "madge": "^8.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
