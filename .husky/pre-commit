
git stash push --keep-index --include-untracked --quiet

make backup-env

test_exit_code=0

make run-unit || test_exit_code=$?
make run-integration || test_exit_code=$?
make run-acceptance || test_exit_code=$?

make restore-env

git stash apply 0 --quiet

git stash drop 0 --quiet

exit $test_exit_code